{
  "$description": "ReviewBuddy design tokens. 'eucalypt-gold' is the active direction. To swap direction, change \"active\" (or set data-theme on <html>) and re-run build_tokens.py. Semantic names stay the same across themes.",
  "active": "eucalypt-gold",
  "themes": {
    "eucalypt-gold": {
      "label": "Eucalypt & Gold",
      "color": {
        "brand":          "#1F4D3F",
        "brand-strong":   "#173B30",
        "brand-tint":     "#E3ECE5",
        "accent":         "#E9A93B",
        "accent-strong":  "#C98A1E",
        "accent-tint":    "#FBEFD8",
        "surface":        "#FBF7F0",
        "surface-alt":    "#EFE6D6",
        "surface-raised": "#FFFFFF",
        "on-brand":       "#FBF7F0",
        "on-brand-muted": "#CFDCCF",
        "on-accent":      "#1D2420",
        "text":           "#1D2420",
        "text-muted":     "#55605A",
        "line":           "#E4DCCD",
        "line-strong":    "#CFC4B0",
        "star":           "#E9A93B",
        "star-empty":     "#D9D2C4",
        "danger":         "#B4412F",
        "success":        "#2F7A5B",
        "focus":          "#E9A93B",
        "app-canvas":     "#F6F4EF",
        "app-panel":      "#FFFFFF",
        "app-line":       "#E7E3DA"
      },
      "font": {
        "display": "'Fraunces', Georgia, 'Times New Roman', serif",
        "body":    "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
        "hand":    "'Caveat', 'Comic Sans MS', cursive",
        "display-settings": "'SOFT' 100, 'WONK' 0, 'opsz' 96",
        "display-weight": 600
      }
    },
    "southern-sky": {
      "label": "Southern Sky (alternative)",
      "color": {
        "brand": "#0E2A47", "brand-strong": "#0A1F35", "brand-tint": "#E4EEF7",
        "accent": "#F4B63F", "accent-strong": "#D99A1F", "accent-tint": "#FDF1D9",
        "surface": "#FBF8F3", "surface-alt": "#F1E9DC", "surface-raised": "#FFFFFF",
        "on-brand": "#FBF8F3", "on-brand-muted": "#B9D3EA", "on-accent": "#14202E",
        "text": "#14202E", "text-muted": "#4E5B6A", "line": "#E3DCCF", "line-strong": "#CCC2B1",
        "star": "#F4B63F", "star-empty": "#D8D2C6", "danger": "#B4412F", "success": "#0B6FAF",
        "focus": "#38B6FF", "app-canvas": "#F5F6F8", "app-panel": "#FFFFFF", "app-line": "#E5E8EC"
      },
      "font": {
        "display": "'Fraunces', Georgia, serif", "body": "'Inter', system-ui, sans-serif", "hand": "'Caveat', cursive",
        "display-settings": "'SOFT' 50, 'WONK' 0, 'opsz' 96", "display-weight": 600
      }
    },
    "ochre-charcoal": {
      "label": "Ochre & Charcoal (alternative)",
      "color": {
        "brand": "#23201D", "brand-strong": "#161412", "brand-tint": "#ECE1D0",
        "accent": "#F2B544", "accent-strong": "#A3471F", "accent-tint": "#FBEBD0",
        "surface": "#F8F3EB", "surface-alt": "#ECE1D0", "surface-raised": "#FFFFFF",
        "on-brand": "#F8F3EB", "on-brand-muted": "#D8CDBC", "on-accent": "#23201D",
        "text": "#23201D", "text-muted": "#5E5750", "line": "#E2D6C3", "line-strong": "#CBBBA3",
        "star": "#F2B544", "star-empty": "#D9CFC0", "danger": "#A3471F", "success": "#3F6B4F",
        "focus": "#F2B544", "app-canvas": "#F6F3EE", "app-panel": "#FFFFFF", "app-line": "#E6E0D6"
      },
      "font": {
        "display": "'Bricolage Grotesque', system-ui, sans-serif", "body": "'DM Sans', system-ui, sans-serif", "hand": "'Caveat', cursive",
        "display-settings": "normal", "display-weight": 700
      }
    }
  },
  "type": {
    "$note": "Mobile-first. [size, line-height] in px. Desktop applies from 1024px. Use clamp() between them.",
    "display": {"mobile": [44, 46], "desktop": [72, 74], "font": "display", "weight": 600, "tracking": "-0.02em"},
    "h1":      {"mobile": [38, 42], "desktop": [60, 64], "font": "display", "weight": 600, "tracking": "-0.015em"},
    "h2":      {"mobile": [28, 34], "desktop": [42, 48], "font": "display", "weight": 600, "tracking": "-0.01em"},
    "h3":      {"mobile": [20, 28], "desktop": [22, 30], "font": "body", "weight": 600, "tracking": "-0.005em"},
    "lead":    {"mobile": [18, 28], "desktop": [21, 32], "font": "body", "weight": 400},
    "body":    {"mobile": [17, 26], "desktop": [18, 28], "font": "body", "weight": 400},
    "small":   {"mobile": [14, 20], "desktop": [14, 20], "font": "body", "weight": 400},
    "eyebrow": {"mobile": [13, 16], "desktop": [13, 16], "font": "body", "weight": 600, "tracking": "0.08em", "case": "uppercase"},
    "callout": {"mobile": [24, 26], "desktop": [26, 28], "font": "hand", "weight": 600}
  },
  "space": {"0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96, "10": 128},
  "section": {"padding-y": {"mobile": 72, "desktop": 128}, "gutter": {"mobile": 20, "desktop": 32}, "max-width": 1200, "text-max": 640},
  "radius": {"sm": 8, "md": 12, "lg": 20, "xl": 28, "pill": 999},
  "shadow": {
    "card": "0 1px 2px rgba(29,36,32,.06), 0 8px 24px -12px rgba(29,36,32,.18)",
    "product": "0 2px 4px rgba(29,36,32,.06), 0 24px 48px -16px rgba(29,36,32,.28), 0 64px 120px -40px rgba(31,77,63,.35)",
    "button": "0 1px 0 rgba(255,255,255,.4) inset, 0 6px 16px -6px rgba(201,138,30,.55)"
  },
  "breakpoints": {"sm": 480, "md": 768, "lg": 1024, "xl": 1280},
  "motion": {"fast": "150ms", "base": "240ms", "ease": "cubic-bezier(.2,.7,.2,1)"}
}
